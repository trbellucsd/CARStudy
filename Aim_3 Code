## =============================================================================
## CAR Study -- 03_aim3_latent_class.R
##
## Aim 3: Evaluate whether latent profiles of driving restriction and cessation
## in the prediagnostic period predict incident ADRD and are associated with
## ADRD biomarkers.
##
## Aim 3 is anchored to a fixed landmark (age 75) rather than to the diagnosis
## date, and asks whether driving histories observed before the landmark, with
## no reference to later diagnostic status, carry prognostic information.
##
## Pipeline:
##   1. Landmark sample and Mplus export
##   2. Class enumeration in Mplus v8 (syntax written by this script)
##   3. Read CPROB, run pseudo-class draws
##   4. H3A: cause-specific Cox, age time scale, death as competing event
##   5. H3B: HRS-HCAP plasma biomarkers
##
## The latent class model is fitted in Mplus; everything downstream is in R.
## =============================================================================

source("00_config_and_helpers.R")

LANDMARK_AGE <- 75
N_PSEUDO     <- 20      # pseudo-class draws
MPLUS_DIR    <- file.path(ROOT, "_mplus")
dir.create(MPLUS_DIR, showWarnings = FALSE, recursive = TRUE)

driving_long <- readRDS(file.path(DER, "driving_long_all_cohorts.rds"))
adrd         <- readRDS(file.path(DER, "adrd_index_all_cohorts.rds"))
covars       <- readRDS(file.path(DER, "baseline_covariates.rds"))

## =============================================================================
## 1. Landmark sample
##
## Profiles use driving observations before age 75. Participants with recorded
## ADRD by age 75 are excluded; later ADRD is the outcome. Cessation is
## absorbing: after a first report of cessation a participant remains ceased
## and contributes no further restriction observations.
## =============================================================================

build_landmark <- function(cohort_name, landmark = LANDMARK_AGE) {
  ids_ok <- adrd %>%
    filter(cohort == cohort_name,
           is.na(age_dx) | age_dx > landmark,
           is.na(age_death) | age_death > landmark) %>%
    pull(id)

  driving_long %>%
    filter(cohort == cohort_name, id %in% ids_ok, age < landmark) %>%
    arrange(id, age) %>%
    group_by(id) %>%
    mutate(ceased_before = cumsum(lag(state, default = 0L) == 2L)) %>%
    filter(ceased_before == 0) %>%
    mutate(
      # R: restriction indicator, defined only while still driving
      R = if_else(state == 2L, NA_integer_, as.integer(state == 1L)),
      # S: cessation indicator, defined while not yet ceased
      S = as.integer(state == 2L),
      occ = row_number()
    ) %>%
    ungroup() %>%
    filter(occ <= 10) %>%                    # Mplus wide format cap
    select(id, cohort, occ, age, R, S)
}

landmark <- map_dfr(COHORTS, build_landmark)

#' Reshape to the wide format Mplus expects: one row per person, with
#' age, R and S at each occasion.
to_mplus_wide <- function(d) {
  d %>%
    pivot_wider(id_cols = c(id, cohort),
                names_from = occ,
                values_from = c(age, R, S),
                names_sep = "") %>%
    left_join(covars, by = c("id", "cohort"))
}

lm_wide <- to_mplus_wide(landmark)

#' Write an Mplus-ready dataset: numeric only, no header, -999 for missing.
write_mplus_data <- function(d, path) {
  num <- d %>% mutate(across(where(is.factor), ~as.integer(.x)),
                      across(where(is.character), ~as.integer(as.factor(.x)))) %>%
    mutate(across(everything(), ~replace_na(as.numeric(.x), -999)))
  write.table(num, path, sep = " ", row.names = FALSE, col.names = FALSE, quote = FALSE)
  names(num)
}

for (ch in COHORTS) {
  d <- lm_wide %>% filter(cohort == ch)
  if (nrow(d) < 200) { message("skipping ", ch, ": n = ", nrow(d)); next }
  vn <- write_mplus_data(d, file.path(MPLUS_DIR, sprintf("aim3_%s.dat", tolower(ch))))
  writeLines(vn, file.path(MPLUS_DIR, sprintf("aim3_%s_varnames.txt", tolower(ch))))
}

## =============================================================================
## 2. Mplus syntax
##
## Joint logistic latent class mixed model, age as the time scale:
##
##   logit Pr(R_ij = 1 | C_i = k, driving)   = pi_0k  + pi_1k  * Age_ij + u_iR
##   logit Pr(S_ij = 1 | C_i = k, not ceased) = lam_0k + lam_1k * Age_ij + u_iC
##
## u_iR and u_iC are correlated participant-specific terms, so within a class
## the two processes are allowed to covary. TYPE = COMPLEX MIXTURE carries the
## survey design; 500 initial and 50 final-stage starts per the Research
## Strategy.
## =============================================================================

write_mplus_inp <- function(cohort_name, k, n_occ = 10,
                            weight = "svy_wt", cluster = "svy_psu", strat = "svy_strat") {
  ch <- tolower(cohort_name)
  ages <- paste0("age", 1:n_occ, collapse = " ")
  Rs   <- paste0("R", 1:n_occ, collapse = " ")
  Ss   <- paste0("S", 1:n_occ, collapse = " ")

  cls <- map_chr(1:k, function(j) {
    paste0(
      sprintf("  %%c#%d%%\n", j),
      "  ! class-specific intercepts and age slopes\n",
      sprintf("  [iR@0 sR@0 iC@0 sC@0];\n"),
      sprintf("  [iR*%.1f sR*0 iC*%.1f sC*0];\n", -1 + j*0.5, -2 + j*0.4)
    )
  }) %>% paste(collapse = "\n")

  inp <- sprintf('
TITLE: CAR Study Aim 3 -- %s, %d-class joint driving profile model;

DATA: FILE = aim3_%s.dat;

VARIABLE:
  NAMES = id cohort %s %s %s age_base sex race educ %s %s %s;
  USEVARIABLES = %s %s;
  CATEGORICAL = %s %s;
  IDVARIABLE = id;
  MISSING = ALL (-999);
  CLASSES = c(%d);
  WEIGHT = %s;
  CLUSTER = %s;
  STRATIFICATION = %s;

ANALYSIS:
  TYPE = COMPLEX MIXTURE;
  ESTIMATOR = MLR;
  STARTS = 500 50;
  PROCESSORS = 8;
  ALGORITHM = INTEGRATION;
  INTEGRATION = MONTECARLO(1000);

MODEL:
  %%OVERALL%%
  ! restriction process: random intercept and age slope
  iR sR | %s;
  ! cessation process: random intercept and age slope
  iC sC | %s;
  ! correlated person-level terms across the two processes
  iR WITH iC;
  sR WITH sC;
  iR WITH sR;
  iC WITH sC;

%s

OUTPUT: TECH11 TECH14 ENTROPY STANDARDIZED;

SAVEDATA:
  FILE = aim3_%s_%dclass_cprob.dat;
  SAVE = CPROBABILITIES;
',
    cohort_name, k, ch,
    ages, Rs, Ss, weight, cluster, strat,
    Rs, Ss, Rs, Ss, k, weight, cluster, strat,
    paste0("R", 1:n_occ, " ON age", 1:n_occ, collapse = ";\n  "),
    paste0("S", 1:n_occ, " ON age", 1:n_occ, collapse = ";\n  "),
    cls, ch, k)

  path <- file.path(MPLUS_DIR, sprintf("aim3_%s_%dclass.inp", ch, k))
  writeLines(inp, path)
  path
}

## Enumeration: two through five classes, developed in HRS, assessed in NHATS,
## examined in ACTIVE where pre-landmark history and class sizes permit.
walk(2:5, ~write_mplus_inp("HRS", .x))
walk(2:5, ~write_mplus_inp("NHATS", .x))
walk(2:4, ~write_mplus_inp("ACTIVE", .x))

## Run Mplus, then collect fit statistics for the enumeration table.
## library(MplusAutomation); runModels(MPLUS_DIR, showOutput = TRUE)

collect_enumeration <- function(dir = MPLUS_DIR) {
  library(MplusAutomation)
  res <- readModels(dir, what = c("summaries", "class_counts"))
  map_dfr(res, function(m) {
    s <- m$summaries
    tibble(model = s$Title, k = s$NLatentClasses,
           LL = s$LL, npar = s$Parameters,
           BIC = s$BIC, aBIC = s$aBIC, AIC = s$AIC,
           entropy = s$Entropy,
           blrt_p = s$BLRT_PValue %||% NA_real_,
           lmr_p = s$T11_LMR_PValue %||% NA_real_,
           min_class_pct = min(m$class_counts$modelEstimated$proportion) * 100)
  }) %>% arrange(model, k)
}
