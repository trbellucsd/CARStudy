## 6a. Exclude the last driving assessment before the landmark
landmark_droplast <- landmark %>%
  group_by(id, cohort) %>% filter(occ < max(occ)) %>% ungroup()

## 6b. Continuous trajectory model instead of discrete classes, to test
## whether results depend on observation history or on discrete grouping
library(lme4)
cont_traj <- landmark %>%
  mutate(age_c = age - 70) %>%
  group_by(id, cohort) %>%
  summarise(
    slope_R = if (sum(!is.na(R)) >= 3)
      coef(lm(R ~ age_c, data = pick(everything())))[2] else NA_real_,
    mean_R  = mean(R, na.rm = TRUE),
    ever_S  = as.integer(any(S == 1, na.rm = TRUE)),
    .groups = "drop")

cont_cox <- surv_frame %>%
  inner_join(cont_traj, by = c("id", "cohort")) %>%
  filter(cohort == "HRS") %>%
  { coxph(Surv(t_start, t_stop, status == 1) ~ slope_R + mean_R + ever_S +
            age_base + sex + race_eth + educ, data = .) }
write_csv(broom::tidy(cont_cox), file.path(OUT, "aim3_continuous_trajectory.csv"))

## 6c. Class entry ages and assessment frequency and spacing, to check that
## classes are not artifacts of observation history
class_diagnostics <- function(cprob_path, k, cohort_name) {
  cp <- read_cprob(cprob_path, k)
  landmark %>% filter(cohort == cohort_name) %>%
    inner_join(cp %>% select(id, modal), by = "id") %>%
    group_by(modal) %>%
    summarise(n = n_distinct(id),
              entry_age = mean(age[occ == 1], na.rm = TRUE),
              n_obs = mean(tapply(occ, id, max), na.rm = TRUE),
              spacing = mean(diff(sort(age)), na.rm = TRUE),
              .groups = "drop")
}

