## =============================================================================
## 3. Pseudo-class draws
##
## Repeated draws from the posterior class probabilities carry classification
## uncertainty into the survival and biomarker models. Estimates are combined
## across draws with Rubin's rules.
## =============================================================================

read_cprob <- function(path, k) {
  cp <- read.table(path, header = FALSE, na.strings = "*")
  ## Mplus SAVEDATA writes the USEVARIABLES, then CPROB1..CPROBk, then the
  ## modal class, then IDVARIABLE. Confirm against the SAVEDATA section of the
  ## .out file before trusting the column positions.
  nc <- ncol(cp)
  out <- cp[, c(1, (nc - k):(nc))]
  names(out) <- c("id", paste0("cprob", 1:k), "modal")
  as_tibble(out)
}

#' Draw a class for each person from their posterior probabilities.
pseudo_draw <- function(cp, k, seed) {
  set.seed(seed)
  P <- as.matrix(cp[, paste0("cprob", 1:k)])
  cp %>% mutate(class = apply(P, 1, function(p) sample.int(k, 1, prob = p)))
}

#' Rubin's rules across pseudo-class draws.
combine_draws <- function(est, se) {
  m  <- length(est)
  qbar <- mean(est)
  ubar <- mean(se^2)
  b    <- var(est)
  tot  <- ubar + (1 + 1/m) * b
  df   <- (m - 1) * (1 + ubar / ((1 + 1/m) * b))^2
  tibble(est = qbar, se = sqrt(tot),
         lo = qbar - qt(.975, df) * sqrt(tot),
         hi = qbar + qt(.975, df) * sqrt(tot),
         p  = 2 * pt(abs(qbar / sqrt(tot)), df, lower.tail = FALSE))
}

## =============================================================================
## 4. H3A: incident ADRD after the landmark
##
## Cause-specific Cox models with age as the time scale. Death before ADRD is
## a competing event. Adjusted for age at landmark, sex, race/ethnicity,
## education, and baseline health conditions and comorbidities.
## =============================================================================

surv_frame <- adrd %>%
  filter(is.na(age_dx) | age_dx > LANDMARK_AGE,
         is.na(age_death) | age_death > LANDMARK_AGE) %>%
  mutate(
    t_start = LANDMARK_AGE,
    t_stop  = pmin(coalesce(age_dx, Inf), coalesce(age_death, Inf),
                   coalesce(age_last_obs, Inf), na.rm = TRUE),
    status  = case_when(!is.na(age_dx)    & age_dx    == t_stop ~ 1L,   # ADRD
                        !is.na(age_death) & age_death == t_stop ~ 2L,   # death
                        TRUE ~ 0L)
  ) %>%
  filter(t_stop > t_start) %>%
  left_join(covars, by = c("id", "cohort"))

run_h3a <- function(cohort_name, k, cprob_path, n_draws = N_PSEUDO) {
  cp <- read_cprob(cprob_path, k)
  sf <- surv_frame %>% filter(cohort == cohort_name) %>%
    inner_join(cp, by = "id")

  draws <- map(seq_len(n_draws), function(dd) {
    s <- pseudo_draw(cp, k, seed = SEED + dd) %>% select(id, class)
    dat <- sf %>% select(-any_of("class")) %>% left_join(s, by = "id") %>%
      mutate(class = relevel(factor(class), ref = "1"))

    des <- svydesign(
      ids     = as.formula(paste0("~", DESIGN[[cohort_name]]$cluster)),
      strata  = if (is.null(DESIGN[[cohort_name]]$strata)) NULL else
        as.formula(paste0("~", DESIGN[[cohort_name]]$strata)),
      weights = as.formula(paste0("~", DESIGN[[cohort_name]]$weight)),
      data = dat, nest = TRUE)

    m <- svycoxph(
      Surv(t_start, t_stop, status == 1) ~ class + age_base + sex + race_eth +
        educ + comorbidity_base,
      design = des)   # comorbidity_base: RwCONDE (HRS) / hc_count (NHATS)
    s2 <- summary(m)$coefficients
    tibble(term = rownames(s2), est = s2[, "coef"], se = s2[, "se(coef)"],
           draw = dd)
  }) %>% bind_rows()

  draws %>% filter(str_detect(term, "^class")) %>%
    group_by(term) %>%
    group_modify(~combine_draws(.x$est, .x$se)) %>%
    ungroup() %>%
    mutate(cohort = cohort_name, k = k,
           hr = exp(est), hr_lo = exp(lo), hr_hi = exp(hi))
}

