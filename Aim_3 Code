## Competing-risks cumulative incidence by class
run_h3a_cif <- function(cohort_name, k, cprob_path) {
  cp <- read_cprob(cprob_path, k)
  dat <- surv_frame %>% filter(cohort == cohort_name) %>%
    inner_join(cp %>% select(id, modal), by = "id")
  library(cmprsk)
  ci <- cuminc(ftime = dat$t_stop - dat$t_start, fstatus = dat$status,
               group = dat$modal, cencode = 0)
  map_dfr(names(ci)[!names(ci) %in% "Tests"], function(nm) {
    tibble(stratum = nm, time = ci[[nm]]$time, cif = ci[[nm]]$est)
  }) %>% mutate(cohort = cohort_name)
}

## =============================================================================
## 5. H3B: HRS-HCAP plasma biomarkers
##
## Linear regression relating pre-assay driving profiles to log-transformed
## plasma Abeta42/40, ptau181, and NfL. Participants need sufficient driving
## history before the assay. Distinguish those with and without CMS-recorded
## ADRD at assay. The first eligible post-driving assay is primary.
## =============================================================================

hcap <- readRDS(file.path(DER, "hrs_hcap_biomarkers.sas7bdat"))
BIOMARKERS <- c("ab4240", "ptau181", "nfl")

run_h3b <- function(k, cprob_path, n_draws = N_PSEUDO) {
  cp <- read_cprob(cprob_path, k)

  bio <- hcap %>%
    inner_join(cp, by = "id") %>%
    filter(n_driving_obs_pre_assay >= 3) %>%
    group_by(id) %>% slice_min(assay_age, n = 1, with_ties = FALSE) %>%
    ungroup() %>%
    mutate(adrd_at_assay = as.integer(!is.na(age_dx) & age_dx <= assay_age),
           across(all_of(BIOMARKERS), ~log(.x), .names = "log_{.col}"))

  map_dfr(BIOMARKERS, function(b) {
    draws <- map_dfr(seq_len(n_draws), function(dd) {
      s <- pseudo_draw(cp, k, seed = SEED + 1000 + dd) %>% select(id, class)
      dat <- bio %>% select(-any_of("class")) %>% left_join(s, by = "id") %>%
        mutate(class = relevel(factor(class), ref = "1"))
      ## HCAP analyses use the corresponding HCAP biomarker weights
      des <- svydesign(ids = ~svy_psu, strata = ~svy_strat, weights = ~wt_hcap,
                       data = dat, nest = TRUE)
      f <- as.formula(sprintf(
        "log_%s ~ class + assay_age + sex + race_eth + educ + bmi + egfr + %s",
        b, "assay_batch"))
      m <- svyglm(f, design = des)
      s2 <- summary(m)$coefficients
      tibble(term = rownames(s2), est = s2[, 1], se = s2[, 2], draw = dd)
    })
    draws %>% filter(str_detect(term, "^class")) %>%
      group_by(term) %>% group_modify(~combine_draws(.x$est, .x$se)) %>%
      ungroup() %>% mutate(biomarker = b)
  }) %>%
    mutate(p_fdr = p.adjust(p, method = "BH"))     # BH across biomarkers
}

